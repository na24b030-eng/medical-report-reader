# Google Gemini API Key (Optional: system automatically uses verified fallback engine if not provided)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=10.0

# Optional custom Tesseract path (Auto-detected if installed)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
