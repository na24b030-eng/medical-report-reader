{
  "info": {
    "name": "Medical Report Reader",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "gemini_api_key",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP status', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.expect(pm.response.json()).to.have.property('status'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Assignment demo",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/demo",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP status', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.expect(pm.response.json()).to.have.property('status'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Text without LLM",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/reports/simplify/text",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\"text\": \"CBC:\\nHemoglobin 10.2 g/dL (Low) Reference: 12.0-15.0\\nWBC 11,200 /uL (High) Reference: 4000-11000\", \"use_gemini\": false}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP status', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.expect(pm.response.json()).to.have.property('status'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Text with Gemini language",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/reports/simplify/text",
        "header": [
          {
            "key": "X-Gemini-API-Key",
            "value": "{{gemini_api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"text\": \"CBC:\\nHemoglobin 10.2 g/dL (Low) Reference: 12.0-15.0\\nWBC 11,200 /uL (High) Reference: 4000-11000\", \"use_gemini\": true}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP status', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.expect(pm.response.json()).to.have.property('status'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Local image OCR",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/reports/simplify/image",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "image",
              "type": "file",
              "src": "../samples/report.png"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP status', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.expect(pm.response.json()).to.have.property('status'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Conflicting flag is rejected",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/reports/simplify/text",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\"text\": \"Hemoglobin 10.2 g/dL (High) Reference: 12-15\", \"use_gemini\": false}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP status', () => pm.response.to.have.status(422));",
              "pm.test('JSON response', () => pm.expect(pm.response.json()).to.have.property('status'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Gemini key required only when enabled",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/reports/simplify/text",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\"text\": \"CBC:\\nHemoglobin 10.2 g/dL (Low) Reference: 12.0-15.0\\nWBC 11,200 /uL (High) Reference: 4000-11000\", \"use_gemini\": true}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP status', () => pm.response.to.have.status(401));",
              "pm.test('JSON response', () => pm.expect(pm.response.json()).to.have.property('status'));"
            ]
          }
        }
      ]
    }
  ]
}
