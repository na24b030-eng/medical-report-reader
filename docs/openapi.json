{
  "openapi": "3.1.0",
  "info": {
    "title": "Medical Report Reader",
    "description": "Local OCR, deterministic extraction and normalization, grounded explanations. Gemini is restricted to optional NLP. No diagnosis or treatment advice.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/reports/simplify/text": {
      "post": {
        "tags": [
          "Reports"
        ],
        "summary": "Simplify Text",
        "operationId": "simplify_text_reports_simplify_text_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TextRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "408": {
            "description": "Request Timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Request Entity Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/reports/simplify/image": {
      "post": {
        "tags": [
          "Reports"
        ],
        "summary": "Simplify Image",
        "operationId": "simplify_image_reports_simplify_image_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_simplify_image_reports_simplify_image_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "408": {
            "description": "Request Timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Request Entity Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/demo": {
      "get": {
        "tags": [
          "Demo"
        ],
        "summary": "Assignment example with explicitly supplied fixture ranges; no Gemini calls",
        "operationId": "demo_demo_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_simplify_image_reports_simplify_image_post": {
        "properties": {
          "image": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Image",
            "description": "PNG, JPEG or WebP; max 5 MB, 16 megapixels; crop to result lines"
          },
          "use_gemini": {
            "type": "boolean",
            "title": "Use Gemini",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "image"
        ],
        "title": "Body_simplify_image_reports_simplify_image_post"
      },
      "ErrorResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "error",
              "unprocessed"
            ],
            "title": "Status"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "reason",
          "request_id"
        ],
        "title": "ErrorResponse"
      },
      "Evidence": {
        "properties": {
          "test_id": {
            "type": "string",
            "title": "Test Id"
          },
          "source_text": {
            "type": "string",
            "title": "Source Text"
          },
          "source_start": {
            "type": "integer",
            "title": "Source Start"
          },
          "source_end": {
            "type": "integer",
            "title": "Source End"
          },
          "raw_name": {
            "type": "string",
            "title": "Raw Name"
          },
          "raw_value": {
            "type": "string",
            "title": "Raw Value"
          },
          "raw_unit": {
            "type": "string",
            "title": "Raw Unit"
          },
          "conversion_factor": {
            "type": "string",
            "title": "Conversion Factor"
          },
          "status_basis": {
            "type": "string",
            "enum": [
              "report_range",
              "report_flag",
              "unavailable"
            ],
            "title": "Status Basis"
          },
          "corrections": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Corrections"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "test_id",
          "source_text",
          "source_start",
          "source_end",
          "raw_name",
          "raw_value",
          "raw_unit",
          "conversion_factor",
          "status_basis",
          "corrections"
        ],
        "title": "Evidence"
      },
      "Extraction": {
        "properties": {
          "tests_raw": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tests Raw"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "confidence_basis": {
            "type": "string",
            "title": "Confidence Basis"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tests_raw",
          "confidence",
          "confidence_basis"
        ],
        "title": "Extraction"
      },
      "Metadata": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "input_type": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "assignment_demo"
            ],
            "title": "Input Type"
          },
          "source_text": {
            "type": "string",
            "title": "Source Text"
          },
          "language_provider": {
            "type": "string",
            "enum": [
              "templates",
              "gemini"
            ],
            "title": "Language Provider"
          },
          "language_status": {
            "type": "string",
            "enum": [
              "not_requested",
              "applied",
              "fallback"
            ],
            "title": "Language Status"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "duration_ms": {
            "type": "integer",
            "title": "Duration Ms"
          },
          "ocr_engine": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ocr Engine"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "input_type",
          "source_text",
          "language_provider",
          "language_status",
          "warnings",
          "duration_ms"
        ],
        "title": "Metadata"
      },
      "Normalization": {
        "properties": {
          "normalization_confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Normalization Confidence"
          },
          "confidence_basis": {
            "type": "string",
            "title": "Confidence Basis"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "normalization_confidence",
          "confidence_basis",
          "evidence"
        ],
        "title": "Normalization"
      },
      "NormalizedTest": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "status": {
            "type": "string",
            "enum": [
              "low",
              "normal",
              "high",
              "unknown"
            ],
            "title": "Status"
          },
          "ref_range": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReferenceRange"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "value",
          "unit",
          "status",
          "ref_range"
        ],
        "title": "NormalizedTest"
      },
      "ReferenceRange": {
        "properties": {
          "low": {
            "type": "number",
            "title": "Low"
          },
          "high": {
            "type": "number",
            "title": "High"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "low",
          "high"
        ],
        "title": "ReferenceRange"
      },
      "ReportResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "tests": {
            "items": {
              "$ref": "#/components/schemas/NormalizedTest"
            },
            "type": "array",
            "title": "Tests"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "explanations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Explanations"
          },
          "extraction": {
            "$ref": "#/components/schemas/Extraction"
          },
          "normalization": {
            "$ref": "#/components/schemas/Normalization"
          },
          "metadata": {
            "$ref": "#/components/schemas/Metadata"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tests",
          "summary",
          "explanations",
          "extraction",
          "normalization",
          "metadata"
        ],
        "title": "ReportResponse"
      },
      "TextRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Text"
          },
          "use_gemini": {
            "type": "boolean",
            "title": "Use Gemini",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "TextRequest"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "description": "Optional per-request key. Used only when use_gemini=true; never saved.",
        "in": "header",
        "name": "X-Gemini-API-Key"
      }
    }
  }
}
